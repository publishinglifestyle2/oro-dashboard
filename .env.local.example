# copia in .env.local per lo sviluppo locale (su Vercel invece: Settings → Environment Variables)

# database TradingView — dopo aver collegato l'integrazione Neon da Vercel Marketplace,
# `vercel env pull .env.local` scrive già questa riga da sola
DATABASE_URL=

# chiave segreta che TradingView deve mettere nell'url del webhook: .../api/webhook/tradingview?key=QUESTA
# generane una lunga e a caso, es: openssl rand -hex 24
TV_WEBHOOK_SECRET=

# ripiego se il database non ha ancora storico: conto OANDA practice (facoltativo)
OANDA_TOKEN=
OANDA_ENV=practice

# rischio
CAPITALE=950
RISCHIO_PCT=2

# se impostata, la pagina chiede questa parola prima di mostrare capitale e segnali
DASHBOARD_PASSCODE=
