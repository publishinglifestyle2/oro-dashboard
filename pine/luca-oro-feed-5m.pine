//@version=6
indicator("Luca Oro — feed 5m", overlay=true)

// Come luca-oro-feed-1m.pine, ma una candela ogni 5 minuti invece che ogni minuto: il motore
// decide comunque solo sulle candele 5m concluse, quindi le decisioni restano identiche — cambia
// solo il dettaglio del grafico. In compenso il database si riaddormenta tra una chiamata e
// l'altra invece di restare sveglio 24/7, che è quello che consumava la quota gratuita in fretta.
//
// Uso: applica questo script a un grafico OANDA:XAUUSD, candele standard, timeframe 5 minuti
// (sostituisce luca-oro-feed-1m.pine — rimuovi il vecchio script/alert dal grafico).
// Poi crea un Alert su questo script, condizione "Luca Oro — feed 5m", "Once Per Bar Close",
// e come webhook URL metti: https://TUO-SITO.vercel.app/api/webhook/tradingview?key=LA_TUA_CHIAVE
// (la chiave deve essere identica a TV_WEBHOOK_SECRET impostata su Vercel).
// Il messaggio dell'alert lo compone da solo lo script qui sotto, non serve scriverlo a mano.

if syminfo.tickerid != "OANDA:XAUUSD" or timeframe.period != "5" or not chart.is_standard
    runtime.error("Applica questo script a OANDA:XAUUSD, candele standard, timeframe 5 minuti.")

messaggio = '{"t":' + str.tostring(time) +
   ',"open":' + str.tostring(open) +
   ',"high":' + str.tostring(high) +
   ',"low":' + str.tostring(low) +
   ',"close":' + str.tostring(close) +
   ',"volume":' + str.tostring(volume) + '}'

alert(messaggio, alert.freq_once_per_bar_close)
